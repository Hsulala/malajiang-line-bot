# ====== LINE Messaging API（LINE Developers Console > Messaging API 分頁）======
LINE_CHANNEL_ACCESS_TOKEN=請填入長效權杖(Channel access token)
LINE_CHANNEL_SECRET=請填入Channel secret

# LIFF App 所屬 Channel 的 Channel ID（LINE Developers Console > Basic settings > Channel ID）
# 用於驗證 LIFF 表單送出時附帶的 idToken，避免被偽造
LINE_CHANNEL_ID=請填入數字ChannelID

# LIFF App ID（LINE Developers Console > LIFF 分頁，新增 LIFF App 後取得，格式like 1234567890-xxxxxxxx）
LIFF_ID=請填入LIFF_ID

# 老闆本人的 LINE userId（用來接收訂單通知/客戶回覆通知）
# 取得方式：先讓老闆的LINE帳號加機器人好友，機器人webhook收到follow事件時
# console.log(event.source.userId) 印出來即可，或參考 README「取得老闆 userId」章節
OWNER_LINE_USER_ID=請填入老闆的LINE_userId

# ====== 資料庫 ======
# Railway 建立 PostgreSQL 服務後會自動提供這個變數，本機開發需自行填入
DATABASE_URL=postgres://user:password@host:5432/dbname

# ====== 後台管理登入 ======
ADMIN_PASSWORD=請設定一組後台登入密碼
JWT_SECRET=請設定一組隨機長字串(用來簽發登入憑證，例如用 openssl rand -hex 32 產生)

# ====== 其他 ======
PORT=3000
# 部署後的對外網址(不含結尾斜線)，例如 https://malajiang-bot.up.railway.app
# 用於組出LIFF表單內連回後端API的網址等
PUBLIC_BASE_URL=https://your-app.up.railway.app
